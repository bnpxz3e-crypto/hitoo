            print(
                '[SAFE ITEM NOT FOUND]',
                wanted_type,
                code
            )

            continue

        key = prize_key(
            representative
        )

        # ----------------------------------------------------
        # goods_id ช่วยป้องกันของชื่อเดียวกันจากคนละตู้
        # ถูกย้ายรวมกัน
        # ----------------------------------------------------

        ref_gid = str(
            representative.get(
                'goods_id'
            )
            or ''
        )

        remaining = qty

        keep = []

        for x in source:

            current_gid = str(
                x.get(
                    'goods_id'
                )
                or ''
            )

            same_item = (
                prize_key(x) == key
                and
                get_local_bag_type(x)
                == wanted_type
                and
                current_gid == ref_gid
            )

            if (
                remaining > 0
                and
                same_item
            ):

                moved.append(
                    x
                )

                target.append(
                    x
                )

                remaining -= 1

            else:

                keep.append(
                    x
                )

        source[:] = keep

    return moved



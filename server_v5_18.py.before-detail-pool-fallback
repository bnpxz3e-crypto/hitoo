def parse_params(handler, body):

    p = dict(
        urllib.parse.parse_qsl(
            urllib.parse.urlparse(
                handler.path
            ).query,
            keep_blank_values=True
        )
    )

    if body:

        text = body.decode(
            'utf-8',
            'ignore'
        )

        ct = (
            handler.headers.get(
                'Content-Type'
            )
            or ''
        ).lower()

        try:

            if (
                'json' in ct
                or
                text.lstrip().startswith(
                    (
                        '{',
                        '['
                    )
                )
            ):

                x = json.loads(
                    text
                )

                if isinstance(
                    x,
                    dict
                ):

                    for k, v in x.items():

                        p[str(k)] = (
                            str(v)
                            if not isinstance(
                                v,
                                (
                                    dict,
                                    list
                                )
                            )
                            else json.dumps(
                                v,
                                sort_keys=True,
                                separators=(
                                    ',',
                                    ':'
                                )
                            )
                        )

            else:

                p.update(
                    dict(
                        urllib.parse.parse_qsl(
                            text,
                            keep_blank_values=True
                        )
                    )
                )

        except Exception as e:

            print(
                '[PARSE PARAM ERROR]',
                e
            )

    return p

